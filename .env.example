# Server-only. Never prefix these variables with NEXT_PUBLIC_.
# Optional canonical browser origin. Required when using 127.0.0.1 or a proxy.
# Set the exact HTTPS origin when moving to the assigned ngrok hostname.
AIDFLOW_PUBLIC_ORIGIN=http://localhost:3000
PAIFLOW_BASE_URL=https://beta.app.paiflow.xyz
PAIFLOW_DEPLOYMENT_ID=
# pfd_ developer token with Read and operate + selected deployment, or legacy pfk_.
PAIFLOW_API_TOKEN=

# Keep the canonical browser origin and Auth.js URL aligned.
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local app role, never the PostgreSQL superuser.
DATABASE_URL=
TEST_DATABASE_URL=
AIDFLOW_PRIVATE_STORAGE_DIR=D:/AidFlowData/private
